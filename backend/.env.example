# Placeholder environment configuration. Copy to .env and fill in real values locally.
DATABASE_URL=postgresql+psycopg://<db_user>:<db_password>@localhost:5432/healthcare_genai

# Comma-separated frontend origins allowed for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local paths (relative to project root or absolute) to Colab-trained predictive artifacts
DIABETES_MODEL_PATH=ai-artifacts/predictive/xgboost_diabetes_model.pkl
DIABETES_IMPUTATION_PATH=ai-artifacts/preprocessing/imputation_values.json
DIABETES_MODEL_NAME=xgboost_diabetes_model
DIABETES_MODEL_VERSION=pima-colab-v1

# Google Gemini API + Medical RAG configuration (never commit real API keys)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_EMBEDDING_BATCH_SIZE=50
GEMINI_TIMEOUT_SECONDS=30.0
VECTOR_STORE_BACKEND=postgres_numpy
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.35
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
GENAI_DEMO_MODE=false

# Legacy GenAI aliases preserved for compatibility
GENAI_PROVIDER=gemini
GENAI_API_KEY=
GENAI_MODEL=gemini-2.5-flash
GENAI_BASE_URL=
GENAI_TIMEOUT_SECONDS=30.0
