# Database configuration:
# Option A: Local Docker PostgreSQL (from root docker-compose.yml)
# DATABASE_URL=postgresql+psycopg://healthcare_user:healthcare_secure_password_2026@localhost:5436/healthcare_genai
#
# Option B: Cloud PostgreSQL (e.g. Aiven, Neon, Supabase, RDS)
# DATABASE_URL=postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=postgresql+psycopg://healthcare_user:healthcare_secure_password_2026@localhost:5436/healthcare_genai

# Comma-separated frontend origins allowed for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local paths to Colab-trained predictive artifacts
DIABETES_MODEL_PATH=ai-artifacts/predictive/xgboost_diabetes_model.pkl
DIABETES_IMPUTATION_PATH=ai-artifacts/preprocessing/imputation_values.json
DIABETES_MODEL_NAME=xgboost_diabetes_model
DIABETES_MODEL_VERSION=pima-colab-v1

# Google Gemini API + Medical RAG configuration
# Set GEMINI_API_KEY from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_EMBEDDING_BATCH_SIZE=50
GEMINI_TIMEOUT_SECONDS=60.0
VECTOR_STORE_BACKEND=postgres_numpy
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.35
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
GENAI_DEMO_MODE=false
GENAI_PROVIDER=gemini
