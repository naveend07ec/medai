# ==============================================================================
# MED-AI Backend Environment Configuration
# ==============================================================================
# INSTRUCTIONS:
# 1. Rename or copy this file to: backend/.env
# 2. Paste the exact credentials shared with you (or use the cloud database below).
# ==============================================================================

# Database Connection (Aiven Cloud PostgreSQL with SSL)
DATABASE_URL=postgresql+psycopg://avnadmin:<YOUR_DATABASE_PASSWORD>@pg-11e7b808-naveendseven-633b.b.aivencloud.com:19550/defaultdb?sslmode=require

# Frontend CORS whitelist
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Predictive Experiment Artifact Paths (Pre-trained Colab models)
DIABETES_MODEL_PATH=ai-artifacts/predictive/xgboost_diabetes_model.pkl
DIABETES_IMPUTATION_PATH=ai-artifacts/preprocessing/imputation_values.json
DIABETES_MODEL_NAME=xgboost_diabetes_model
DIABETES_MODEL_VERSION=pima-colab-v1

# Google Gemini API & Medical RAG Configuration
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_EMBEDDING_BATCH_SIZE=50
GEMINI_TIMEOUT_SECONDS=60.0

# Vector Knowledge Base Settings
VECTOR_STORE_BACKEND=postgres_numpy
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.35
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
GENAI_DEMO_MODE=false
GENAI_PROVIDER=gemini
